# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase config (contains API keys — do not commit)
google-services.json
GoogleService-Info.plist

# Firebase Admin SDK service account credentials — grants full admin access
# bypassing all security rules, must never be committed
serviceAccount.json

# local env files
# .env itself matters: app.config.js reads GOOGLE_MAPS_API_KEY from it for local
# builds, so it holds a real API key. `.env*.local` alone does NOT match it.
.env
.env*.local

# stray debug output
pglite-debug.log

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# python bytecode from the promo-video scripts
__pycache__/
*.pyc

# firebase deploy cache
.firebase/

# build artifacts downloaded for testing — an AAB from EAS, the universal APK
# Play Console generates from it. Hundreds of megabytes each, reproducible from
# a commit, and nothing reads them from here.
*.apk
*.aab

# buildTravelMatrix resume state — a partial run, superseded by the finished
# data/travel/<cityId>.json and deleted the moment the run completes
data/travel/.cache-*.json

# Partial travel matrices from buildTravelMatrix --sample. A look at a few
# cells, not a city build, and easy to mistake for one.
data/travel/*.sample.json
