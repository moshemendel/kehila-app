rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }
    // Excludes anonymous guest sessions — guests get a real (non-null) auth
    // token so they can receive eruv push, but must not be able to consume
    // real resources (e.g. booking a mikveh slot) under that identity.
    function isRealAccount() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // An account's roles are the ARRAY when it has one, falling back to the
    // singular field for profiles predating it.
    //
    // Reading only `role` quietly broke every multi-role account. The admin UI
    // assigns a set, but `role` holds one value — computePrimaryRole collapses
    // the set to its highest-priority member — so a gabbai who is also an
    // event_manager is stored as role: 'event_manager', and every gabbai grant
    // here evaluated false. They kept seeing their synagogues in the management
    // screen, which filters on managedSynagogueIds without consulting a role at
    // all, and their saves were rejected.
    //
    // Safe to authorise from: the array is already treated as privilege-bearing
    // by the users rules above — self-edits cannot touch it, and creates cannot
    // seed it — so it is exactly as trustworthy as the singular field.
    function userRoles() {
      return userDoc().get('roles', [userDoc().role]);
    }
    function hasRole(role) {
      return isSignedIn() && role in userRoles();
    }
    // City-wide manager roles (kosher_manager, event_manager, eruv_manager,
    // mikveh_manager) previously granted access in every city — fine for a
    // single-city pilot, but a real privilege gap once there's more than one.
    // homeCityId is already populated on every user at creation (see
    // createUser.ts / UsersPage.tsx's handleRoleSave), so this needs no
    // backfill — mirrors isCityAdminOf's exact pattern for city_admin.
    function hasCityRole(role, targetCityId) {
      return isSignedIn() && role in userRoles() && userDoc().homeCityId == targetCityId;
    }
    // A mikveh's own doc is the source of truth for its cityId — used to
    // city-scope mikveh_manager's access to the appointments/appointmentSlots
    // subcollections, which don't carry cityId themselves.
    function mikvehCityId(mikId) {
      return get(/databases/$(database)/documents/mikvaot/$(mikId)).data.cityId;
    }
    // city_admin, super_admin, dev — full management access
    function isAdminRole() {
      return isSignedIn() && userDoc().role in ['city_admin', 'super_admin', 'dev'];
    }
    // super_admin/dev are unscoped — they administer every city
    function isSuperAdminRole() {
      return isSignedIn() && userDoc().role in ['super_admin', 'dev'];
    }
    // A city_admin's homeCityId is their permanent admin scope (never the personal,
    // freely-switchable cityId) — this checks they administer exactly targetCityId.
    function isCityAdminOf(targetCityId) {
      return isSignedIn() && userDoc().role == 'city_admin' && userDoc().homeCityId == targetCityId;
    }
    // Combines a super_admin's unscoped reach with a city_admin's city-scoped
    // reach — the scoped drop-in replacement for isAdminRole() wherever a
    // document's cityId should gate what a city_admin can touch.
    function isAdminOf(targetCityId) {
      return isSuperAdminRole() || isCityAdminOf(targetCityId);
    }
    function managesSynagogue(synId, synCityId) {
      return isSignedIn() && (
        isAdminOf(synCityId) ||
        (hasRole('gabbai') && synId in userDoc().managedSynagogueIds)
      );
    }
    // kosher_manager: city-wide cert access
    // business_manager: only their assigned businesses (stored in managedRestaurantIds)
    function managesBusiness(bizId, bizCityId) {
      return isSignedIn() && (
        isAdminOf(bizCityId) ||
        hasCityRole('kosher_manager', bizCityId) ||
        (hasRole('business_manager') && bizId in userDoc().managedRestaurantIds)
      );
    }

    // ── Cities — public read; super_admin writes any city, city_admin only their own ──
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isSuperAdminRole() || isCityAdminOf(cityId);
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdminRole() || isCityAdminOf(resource.data.homeCityId));
      allow create: if isSignedIn() && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('managedSynagogueIds' in request.resource.data) || request.resource.data.managedSynagogueIds.size() == 0)
        && (!('managedRestaurantIds' in request.resource.data) || request.resource.data.managedRestaurantIds.size() == 0);
      // A city_admin can manage any field of a user within their own homeCityId scope,
      // but cannot themselves reassign a user's homeCityId — moving someone to a
      // different city's administration is a super_admin-only action.
      allow update: if isSuperAdminRole() ||
        (isCityAdminOf(resource.data.homeCityId) &&
         !('homeCityId' in request.resource.data.diff(resource.data).affectedKeys())) ||
        (isSignedIn() && request.auth.uid == userId &&
         !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
         // roles (the multi-role array) is just as privilege-bearing as role —
         // push targeting (sendPushToRoles) filters on it, so letting users
         // self-edit it would let anyone subscribe to admin-targeted pushes.
         !('roles' in request.resource.data.diff(resource.data).affectedKeys()) &&
         !('managedSynagogueIds' in request.resource.data.diff(resource.data).affectedKeys()) &&
         !('managedRestaurantIds' in request.resource.data.diff(resource.data).affectedKeys()) &&
         // A city_admin's homeCityId is their admin jurisdiction — letting them move it
         // themselves would be self-service privilege escalation to another city, so
         // only non-city_admin accounts may self-edit homeCityId (e.g. a regular user
         // relocating, which just repoints their eruv/kashrut push targeting).
         (!('homeCityId' in request.resource.data.diff(resource.data).affectedKeys()) || resource.data.role != 'city_admin'));
    }

    // ── Synagogues — public read; gabbai/admin write ─────────────────────────
    match /synagogues/{synId} {
      allow read: if true;
      allow create: if managesSynagogue(synId, request.resource.data.cityId);
      allow update, delete: if managesSynagogue(synId, resource.data.cityId);
    }

    // ── Businesses (kosher directory) — public read; manager/admin write ─────
    match /businesses/{bizId} {
      allow read: if true;
      allow create: if managesBusiness(bizId, request.resource.data.cityId);
      allow update, delete: if managesBusiness(bizId, resource.data.cityId);
    }

    // ── Mikvaot ──────────────────────────────────────────────────────────────
    match /mikvaot/{mikId} {
      allow read: if true;
      allow create: if isAdminOf(request.resource.data.cityId) || hasCityRole('mikveh_manager', request.resource.data.cityId);
      allow update, delete: if isAdminOf(resource.data.cityId) || hasCityRole('mikveh_manager', resource.data.cityId);

      // Appointment docs store userId — reads restricted to the owner or a
      // mikveh manager/admin. Regular users get slot occupancy from the
      // non-identifying appointmentSlots mirror below instead.
      match /appointments/{appointmentId} {
        allow read:   if isSignedIn()
                         && (resource.data.userId == request.auth.uid
                             || isAdminRole()
                             || hasCityRole('mikveh_manager', mikvehCityId(mikId)));
        allow create: if isRealAccount()
                         && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn()
                         && (resource.data.userId == request.auth.uid
                             || isAdminRole()
                             || hasCityRole('mikveh_manager', mikvehCityId(mikId)));
        allow delete: if isSignedIn()
                         && (resource.data.userId == request.auth.uid
                             || isAdminRole()
                             || hasCityRole('mikveh_manager', mikvehCityId(mikId)));
      }

      // Non-identifying mirror of active bookings (date/time/apptId only, no
      // userId) — lets any signed-in user compute slot availability without
      // being able to read who booked what.
      //
      // Doc ids are DETERMINISTIC ("{date}_{HH-MM}_t{track}"), one per
      // occupied (base slot × parallel track). Together with create-only
      // access (no update rule → set() on an existing id is an update →
      // denied), this makes the mirror a uniqueness lock: when two bookings
      // race for the same track, the loser's whole batch fails atomically.
      //
      // Legacy mirror docs (random id == their appointment's id, carrying
      // slotsCount, no apptId) still exist until cancelled — the delete rule
      // keeps a fallback branch for them.
      match /appointmentSlots/{slotId} {
        allow read:   if isSignedIn();
        // getAfter ties the mirror to a real appointment written in the SAME
        // batch under the caller's own uid — a fabricated slot doc with no
        // matching appointment (fake occupancy to block slots) can't exist.
        allow create: if isRealAccount()
                         && request.resource.data.keys().hasOnly(['date', 'time', 'apptId'])
                         && request.resource.data.date is string
                         && request.resource.data.time is string
                         && getAfter(/databases/$(database)/documents/mikvaot/$(mikId)/appointments/$(request.resource.data.apptId)).data.userId == request.auth.uid;
        allow delete: if isAdminRole()
                         || hasCityRole('mikveh_manager', mikvehCityId(mikId))
                         || (isSignedIn() && 'apptId' in resource.data
                             && get(/databases/$(database)/documents/mikvaot/$(mikId)/appointments/$(resource.data.apptId)).data.userId == request.auth.uid)
                         // Legacy docs: mirror id == appointment id
                         || (isSignedIn() && !('apptId' in resource.data)
                             && get(/databases/$(database)/documents/mikvaot/$(mikId)/appointments/$(slotId)).data.userId == request.auth.uid);
      }
    }

    // ── Kashrut config ───────────────────────────────────────────────────────
    match /kashrutConfig/{cityId} {
      allow read: if true;
      allow write: if isAdminOf(cityId) || hasCityRole('kosher_manager', cityId);
    }

    // ── Kashrut updates feed ─────────────────────────────────────────────────
    match /kashrutUpdates/{id} {
      allow read: if true;
      allow create: if isAdminOf(request.resource.data.cityId) || hasCityRole('kosher_manager', request.resource.data.cityId);
      allow update, delete: if isAdminOf(resource.data.cityId) || hasCityRole('kosher_manager', resource.data.cityId);
    }

    // ── Community events ──────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdminOf(request.resource.data.cityId) || hasCityRole('event_manager', request.resource.data.cityId));
      allow update, delete: if isAdminOf(resource.data.cityId) || hasCityRole('event_manager', resource.data.cityId) ||
        (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ── Pending (gabay-submitted) events ─────────────────────────────────────
    match /pending_events/{docId} {
      allow read: if isAdminOf(resource.data.cityId) || hasCityRole('event_manager', resource.data.cityId);
      allow create: if isSignedIn() && (
        isAdminOf(request.resource.data.cityId) || hasCityRole('event_manager', request.resource.data.cityId) || hasRole('gabbai')
      );
      allow update: if isAdminOf(resource.data.cityId) || hasCityRole('event_manager', resource.data.cityId);
      allow delete: if isAdminOf(resource.data.cityId);
    }

    // ── Analytics events ──────────────────────────────────────────────────────
    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn();
      allow read:   if isAdminRole();
    }

    // ── Push notification tokens ──────────────────────────────────────────────
    // Keyed by device id (not uid) so one physical device never ends up with more than
    // one token doc, even if multiple accounts have logged into it over time.
    match /pushTokens/{deviceId} {
      allow read: if isAdminRole();
      // uid must be the caller's own — and role must match their real Firestore
      // role (or literally 'guest' for anonymous sessions), not whatever the
      // client claims. Without the role check, any signed-in user could write
      // role: 'city_admin' onto their own token doc and receive admin-targeted
      // pushes via sendPushToRoles(), which filters purely on this field.
      //
      // The previous exact-uid-match attempt here was dropped as "mysteriously"
      // failing — root cause: the mobile caller (PrayerNotificationScheduler)
      // registered using appUser.uid (a field self-reported on the Firestore
      // profile doc) instead of firebaseUser.uid (the actual live Auth uid
      // request.auth.uid is evaluated against) for real accounts. Those two
      // aren't guaranteed to be identical, so the strict rule wasn't actually
      // wrong — the client just wasn't reliably sending its own real uid. Fixed
      // there too; this rule is safe to re-enable now.
      // The roles ARRAY must be validated too, not just the singular role —
      // sendPushToRoles() filters on the array *first*, so validating only the
      // singular field would leave the exact escalation it exists to prevent:
      // write role: <real role> (passes) + roles: ['city_admin'] (targeted).
      // For real accounts the array must equal the profile's roles (or
      // [role] when the profile has no roles field, matching what
      // registerPushToken sends); guests are pinned to 'guest' / ['guest'].
      allow create, update: if isSignedIn()
                                && request.resource.data.uid == request.auth.uid
                                && (isRealAccount()
                                     ? (request.resource.data.role == userDoc().role
                                        && request.resource.data.roles == userDoc().get('roles', [userDoc().role]))
                                     : (request.resource.data.role == 'guest'
                                        && request.resource.data.roles == ['guest']));
      // Admins can prune stale/legacy tokens (e.g. Expo's DeviceNotRegistered
      // cleanup); a device can also self-delete its own token doc on logout.
      allow delete: if isAdminRole() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ── Sent notifications log ───────────────────────────────────────────────
    match /sentNotifications/{id} {
      allow read, write: if isAdminRole();
    }

    // ── Eruv status ───────────────────────────────────────────────────────────
    match /eruvStatus/{cityId} {
      allow read: if true;
      allow write: if isAdminOf(cityId) || hasCityRole('eruv_manager', cityId);
    }

    // ── Eruv reports ──────────────────────────────────────────────────────────
    match /eruvReports/{reportId} {
      allow read: if isAdminOf(resource.data.cityId) || hasCityRole('eruv_manager', resource.data.cityId);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdminOf(resource.data.cityId) || hasCityRole('eruv_manager', resource.data.cityId);
      allow delete: if isAdminOf(resource.data.cityId);
    }

    // ── Gemachs — public read; admin or the original submitter can write ─────
    match /gemachs/{gemachId} {
      allow read: if true;
      allow create: if isAdminOf(request.resource.data.cityId);
      allow update, delete: if isAdminOf(resource.data.cityId) ||
        (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ── Pending gemach submissions ────────────────────────────────────────────
    // (same isAdminRole()-blanket gap as pending_events — scoped alongside it
    // even though it wasn't in the originally-called-out collection list.)
    match /pending_gemachs/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdminOf(resource.data.cityId);
    }

    // ── Content reports — users flagging wrong info on a public listing ───────
    // Anyone signed in (including guests, who hold a real anonymous uid) may
    // file a report, but only carrying their OWN uid, so reports stay
    // attributable and a client can't forge another user's. Reading and
    // resolving is admin-only: reports can name a specific place and person,
    // so they are not public the way the listings themselves are.
    match /contentReports/{reportId} {
      // Whoever can fix the reported listing can see and close the report.
      // managesSynagogue/managesBusiness already fold in isAdminOf, so city and
      // super admins are covered by every branch.
      //
      // NOTE for clients: Firestore rules are not filters. A manager who cannot
      // read every report in the city must scope their QUERY to the subset this
      // allows (see services/reports.ts fetchReportsFor), or the whole query
      // fails with permission-denied rather than returning a filtered list.
      function managesReported() {
        return (resource.data.entityType == 'synagogue'
                 && managesSynagogue(resource.data.entityId, resource.data.cityId))
            || (resource.data.entityType == 'business'
                 && managesBusiness(resource.data.entityId, resource.data.cityId))
            || (resource.data.entityType == 'mikveh'
                 && hasCityRole('mikveh_manager', resource.data.cityId))
            || (resource.data.entityType == 'event'
                 && hasCityRole('event_manager', resource.data.cityId));
        // 'gemach' has no dedicated manager role — admins only, via the checks below.
      }
      // Reporting is the one write a member of the public makes that lands in a
      // manager's queue, so it costs a confirmed address. This is the real gate;
      // the check in ReportListingButton only saves the user a round-trip.
      // Note this also excludes guests — an anonymous token carries no
      // email_verified claim, and an anonymous report can't be followed up on.
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update: if isAdminOf(resource.data.cityId) || managesReported();
      // Deleting destroys the audit trail — admins only, managers just resolve.
      allow delete: if isAdminOf(resource.data.cityId);
    }

  }
}
